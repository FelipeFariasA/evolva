  "components": [
    {
      "name": "Botón principal",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Acción principal en la línea del objetivo (\"Entrenar hoy\").",
      "html": "<button class=\"ds-btn\">Entrenar hoy</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;border-radius:8px;padding:12px 18px;min-height:48px;background:var(--linea,#2f6fe4);color:var(--on-linea,#fff);font:800 16px/1.2 Overpass,system-ui,sans-serif;letter-spacing:.01em;cursor:pointer;transition:filter 140ms cubic-bezier(.16,1,.3,1),transform 110ms cubic-bezier(.16,1,.3,1)}.ds-btn:hover{filter:brightness(1.08)}.ds-btn:active{transform:scale(.97)}.ds-btn:focus-visible{outline:3px solid var(--ring,#2f6fe4);outline-offset:2px}"
    },
    {
      "name": "Botón secundario",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "La línea al 14% sobre la superficie (\"Registrar comida\").",
      "html": "<button class=\"ds-btn-sec\">Registrar comida</button>",
      "css": ".ds-btn-sec{display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:8px;padding:12px 18px;min-height:48px;background:color-mix(in srgb,var(--linea,#2f6fe4) 14%,var(--plate,#fbfaf7));color:var(--tx,#0e1a3a);font:800 16px/1.2 Overpass,system-ui,sans-serif;cursor:pointer;transition:filter 140ms cubic-bezier(.16,1,.3,1),transform 110ms cubic-bezier(.16,1,.3,1)}.ds-btn-sec:hover{filter:brightness(1.08)}.ds-btn-sec:active{transform:scale(.97)}.ds-btn-sec:focus-visible{outline:3px solid var(--ring,#2f6fe4);outline-offset:2px}"
    },
    {
      "name": "Chips de nivel",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Selector de nivel o día; el nivel actual lleva \"· actual\".",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip ds-on\">Principiante<span>· actual</span></button><button class=\"ds-chip\">Intermedio</button></div>",
      "css": ".ds-chips{display:flex;gap:8px;flex-wrap:wrap}.ds-chip{border:1.5px solid var(--line,#d5d0c3);background:var(--plate,#fbfaf7);color:var(--tx,#0e1a3a);border-radius:999px;padding:8px 14px;min-height:44px;font:600 15px Overpass,system-ui,sans-serif;cursor:pointer;transition:background-color 140ms cubic-bezier(.16,1,.3,1),border-color 140ms cubic-bezier(.16,1,.3,1),transform 110ms}.ds-chip span{margin-left:6px;font-size:12px;font-weight:700;opacity:.85}.ds-chip:hover{border-color:var(--linea,#2f6fe4)}.ds-chip:active{transform:scale(.97)}.ds-chip:focus-visible{outline:3px solid var(--ring,#2f6fe4);outline-offset:2px}.ds-chip.ds-on{background:var(--linea,#2f6fe4);border-color:var(--linea,#2f6fe4);color:var(--on-linea,#fff);font-weight:800}"
    },
    {
      "name": "Campo",
      "kind": "input",
      "refersTo": "input",
      "description": "Campo de 48px con halo de la línea al enfocar.",
      "html": "<label class=\"ds-label\">Peso (kg)<input class=\"ds-input\" placeholder=\"72,5\"></label>",
      "css": ".ds-label{display:block;font:600 14px Overpass,system-ui,sans-serif;color:var(--mut,#4a5578)}.ds-input{display:block;margin-top:6px;width:100%;box-sizing:border-box;font:16px Overpass,system-ui,sans-serif;min-height:48px;padding:11px 14px;border:1.5px solid var(--line,#d5d0c3);border-radius:8px;background:var(--plate,#fbfaf7);color:var(--tx,#0e1a3a);transition:border-color 140ms cubic-bezier(.16,1,.3,1),box-shadow 140ms cubic-bezier(.16,1,.3,1)}.ds-input::placeholder{color:var(--mut,#4a5578);font-style:italic}.ds-input:focus{outline:none;border-color:var(--linea,#2f6fe4);box-shadow:0 0 0 3px color-mix(in srgb,var(--linea,#2f6fe4) 28%,transparent)}"
    },
    {
      "name": "Navegación inferior",
      "kind": "nav",
      "refersTo": "tab-bar",
      "description": "Barra azul noche fija; la pestaña activa lleva una barra de la línea arriba.",
      "html": "<nav class=\"ds-tabs\"><button class=\"ds-tab ds-on\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"><path d=\"M2 12h20\"/><circle cx=\"7\" cy=\"12\" r=\"3\" fill=\"#0e1a3a\"/><circle cx=\"17\" cy=\"12\" r=\"3\" fill=\"currentColor\"/></svg>Inicio</button><button class=\"ds-tab\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M6 7v10M18 7v10M3 10v4M21 10v4M6 12h12\"/></svg>Rutina</button><button class=\"ds-tab\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 20h18M5 16l4-5 4 3 6-8\"/></svg>Progreso</button></nav>",
      "css": ".ds-tabs{display:flex;background:var(--noche,#0e1a3a);padding:4px 4px 2px}.ds-tab{flex:1;position:relative;background:none;border:0;padding:8px 0;min-height:58px;display:flex;flex-direction:column;align-items:center;gap:4px;font:600 12px Overpass,system-ui,sans-serif;color:var(--on-noche-mut,#aab3cf);cursor:pointer;transition:color 140ms cubic-bezier(.16,1,.3,1)}.ds-tab svg{width:24px;height:24px}.ds-tab::before{content:'';position:absolute;top:0;left:28%;right:28%;height:4px;border-radius:0 0 3px 3px;background:var(--linea,#2f6fe4);transform:scaleX(0);transition:transform 260ms cubic-bezier(.16,1,.3,1)}.ds-tab:hover{color:var(--on-noche,#f4f1ea)}.ds-tab:focus-visible{outline:3px solid var(--ring,#2f6fe4);outline-offset:-3px}.ds-tab.ds-on{color:var(--on-noche,#f4f1ea);font-weight:800}.ds-tab.ds-on::before{transform:scaleX(1)}"
    },
    {
      "name": "Diagrama de línea",
      "kind": "custom",
      "refersTo": "lineaNivel",
      "description": "Firma: niveles como estaciones en un riel de 6px; el tren marca el avance. Solo en Inicio, Rutina y Progreso.",
      "html": "<div class=\"ds-linea\" role=\"img\" aria-label=\"Estación Principiante, 64% del tramo hacia Intermedio\"><div class=\"ds-riel\"><b style=\"width:32%\"></b><i class=\"ds-est ds-aqui\" style=\"left:0%\"><span>Principiante</span></i><i class=\"ds-est\" style=\"left:50%\"><span>Intermedio</span></i><i class=\"ds-est\" style=\"left:100%\"><span>Avanzado</span></i><em class=\"ds-tren\" style=\"left:32%\">64%</em></div></div>",
      "css": ".ds-linea{background:var(--noche,#0e1a3a);color:var(--on-noche,#f4f1ea);padding:4px 28px 52px;font-family:Overpass,system-ui,sans-serif}.ds-riel{position:relative;height:6px;margin:30px 0 0;background:var(--noche-3,#26345f);border-radius:3px}.ds-riel b{position:absolute;inset:0 auto 0 0;border-radius:3px;background:var(--linea,#2f6fe4);transform-origin:left;animation:dsRiel 900ms cubic-bezier(.16,1,.3,1) both}@keyframes dsRiel{from{transform:scaleX(0)}}.ds-est{font-style:normal;position:absolute;top:50%;width:22px;height:22px;margin:-11px 0 0 -11px;border-radius:50%;background:var(--porcelana,#f4f1ea);border:5px solid var(--noche-3,#26345f);box-sizing:border-box}.ds-est span{position:absolute;top:22px;left:50%;transform:translateX(-50%);white-space:nowrap;font-size:12px;font-weight:700;color:var(--on-noche-mut,#aab3cf)}.ds-est:last-of-type span{left:auto;right:0;transform:none}.ds-aqui{width:30px;height:30px;margin:-15px 0 0 -15px;border-width:7px;border-color:var(--linea,#2f6fe4);box-shadow:0 0 0 4px var(--noche,#0e1a3a)}.ds-aqui span{top:28px;left:-4px;transform:none;color:var(--on-noche,#f4f1ea);font-weight:800}.ds-tren{position:absolute;top:-30px;transform:translateX(-50%);background:var(--porcelana,#f4f1ea);color:var(--noche,#0e1a3a);font:800 12px/1 Overpass,system-ui,sans-serif;font-style:normal;padding:5px 7px;border-radius:4px}.ds-tren::after{content:'';position:absolute;left:50%;bottom:-5px;margin-left:-5px;border:5px solid transparent;border-bottom:0;border-top-color:var(--porcelana,#f4f1ea)}@media (prefers-reduced-motion:reduce){.ds-riel b{animation:none}}"
    },
    {
      "name": "Placa de servicio",
      "kind": "card",
      "refersTo": "placa",
      "description": "Porcelana en ambos modos: luz del semáforo con puntaje, estado en palabras, servicio y motivo. Nunca solo color.",
      "html": "<section class=\"ds-placa\" aria-label=\"Estado de tu semana\"><div class=\"ds-light ds-amarillo\" role=\"img\" aria-label=\"Puntaje 65 de 100\"><b>65</b><span>de 100</span></div><div class=\"ds-estado\">Estancado</div><div class=\"ds-serv\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M5 9h14M5 15h14\"/></svg>Servicio con demoras · semana del 2 nov</div><div class=\"ds-motivo\"><b>La proteína quedó bajo la meta la mayoría de los días</b></div></section>",
      "css": ".ds-placa{background:var(--placa,#f4f1ea);color:var(--noche,#0e1a3a);border:1.5px solid #d9d3c4;border-radius:10px;padding:16px;box-shadow:0 10px 28px rgba(14,26,58,.22);display:grid;grid-template-columns:auto 1fr;gap:4px 16px;align-items:center;font-family:Overpass,system-ui,sans-serif;font-variant-numeric:tabular-nums}.ds-light{grid-row:1/3;width:92px;height:92px;border-radius:12px;display:flex;flex-direction:column;align-items:center;justify-content:center}.ds-light b{font:900 48px/.9 Overpass,system-ui,sans-serif}.ds-light span{font-size:12px;font-weight:700;opacity:.85}.ds-amarillo{background:var(--amarillo,#f2b200);color:var(--on-amarillo,#0e1a3a)}.ds-estado{font:900 26px/1.05 Overpass,system-ui,sans-serif;letter-spacing:-.01em}.ds-serv{font-size:14px;font-weight:700;display:flex;align-items:center;gap:6px}.ds-motivo{grid-column:1/3;margin-top:10px;padding-top:10px;border-top:1.5px solid #d9d3c4;font-size:15px}"
    },
    {
      "name": "Semana L–D",
      "kind": "custom",
      "refersTo": "semana",
      "description": "Siete estaciones en un riel: llena = entrenaste, borde de la línea = hoy.",
      "html": "<div class=\"ds-semana\" role=\"list\" aria-label=\"Sesiones de la semana\"><div class=\"ds-dia ds-ok\" role=\"listitem\"><i></i>L</div><div class=\"ds-dia\" role=\"listitem\"><i></i>M</div><div class=\"ds-dia ds-ok\" role=\"listitem\"><i></i>X</div><div class=\"ds-dia ds-hoy\" role=\"listitem\"><i></i>J</div><div class=\"ds-dia\" role=\"listitem\"><i></i>V</div><div class=\"ds-dia\" role=\"listitem\"><i></i>S</div><div class=\"ds-dia\" role=\"listitem\"><i></i>D</div></div>",
      "css": ".ds-semana{display:flex;justify-content:space-between;position:relative;margin-top:20px;font-family:Overpass,system-ui,sans-serif}.ds-semana::before{content:'';position:absolute;top:12px;left:12px;right:12px;height:6px;border-radius:3px;background:var(--line,#d5d0c3)}.ds-dia{position:relative;width:30px;text-align:center;font-size:12px;font-weight:700;color:var(--mut,#4a5578)}.ds-dia i{display:block;box-sizing:border-box;width:30px;height:30px;margin:0 auto 4px;border-radius:50%;background:var(--ground,#f4f1ea);border:5px solid var(--line,#d5d0c3)}.ds-ok i{background:var(--linea,#2f6fe4);border-color:var(--linea,#2f6fe4)}.ds-hoy{color:var(--tx,#0e1a3a);font-weight:900}.ds-hoy i{border-color:var(--linea,#2f6fe4)}.ds-hoy::after{content:'hoy';position:absolute;left:50%;top:-18px;transform:translateX(-50%);font-size:11px;font-weight:800;color:var(--linea,#2f6fe4)}"
    },
    {
      "name": "Letrero de próxima estación",
      "kind": "custom",
      "refersTo": "letrero",
      "description": "Señal de andén azul noche con la decisión de nivel y su razón.",
      "html": "<div class=\"ds-letrero\"><h2>Próxima estación: Intermedio</h2><p><b>Mantén Principiante.</b> Para subir necesitas 85% de adherencia en 3 semanas (llevas 67%).</p></div>",
      "css": ".ds-letrero{background:var(--noche,#0e1a3a);color:var(--on-noche,#f4f1ea);border-radius:10px;padding:14px 16px;font-family:Overpass,system-ui,sans-serif}.ds-letrero h2{margin:6px 0 0;font:800 22px/1.1 Overpass,system-ui,sans-serif;letter-spacing:-.01em}.ds-letrero h2::before{content:'';display:inline-block;width:10px;height:10px;border-radius:50%;background:var(--porcelana,#f4f1ea);border:5px solid var(--linea,#2f6fe4);margin-right:10px;vertical-align:-1px}.ds-letrero p{margin:8px 0 0}"
    },
    {
